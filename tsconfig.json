{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "./application/src",
    "outDir": "./application/dist",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "declaration": true,

    "forceConsistentCasingInFileNames": true
  }
}